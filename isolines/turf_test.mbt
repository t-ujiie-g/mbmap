///|
test "isolines nan and infinite breaks lines" {
  let t = grid([
    0.0015101945441319247, 0.0010067963627546188, 0.0, 0.0015101945441319247, 0.01,
    5.0, 0.0015101945441319247, 0.01899320363724538, 3.0, 0.010503398181377308, 0.0010067963627546188,
    1.0, 0.010503398181377308, 0.01, 8.0, 0.010503398181377308, 0.01899320363724538,
    9.0, 0.019496601818622693, 0.0010067963627546188, 2.0, 0.019496601818622693,
    0.01, 4.0, 0.019496601818622693, 0.01899320363724538, 7.0, 0.028489805455868076,
    0.0010067963627546188, 6.0, 0.028489805455868076, 0.01, 5.0, 0.028489805455868076,
    0.01899320363724538, 1.0,
  ])
  let got = @isolines.isolines(
    t,
    [@double.not_a_number, @double.infinity, @double.neg_infinity, 5.0],
    "elevation",
  )
  assert_eq(
    digest(got.unwrap(), "elevation"),
    "none|NaN|\nnone|Infinity|\nnone|-Infinity|\nMultiLineString|5|0.004507929089880386,0.01899320363724538 0.0015101945441319247,0.01 0.01050339818137731,0.006145769869751979 0.01724830090931135,0.01 0.019496601818622693,0.01299773454574846 0.022494336364371155,0.01899320363724538;0.02848980545586808,0.01 0.02848980545586808,0.01 0.026241504546556736,0.0010067963627546188",
  )
}

