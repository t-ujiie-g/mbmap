///|
test "isobands missing values bands" {
  let t = grid([
    0.0015101945441319247, 0.0010067963627546188, 0.0, 0.0015101945441319247, 0.01,
    @double.not_a_number, 0.0015101945441319247, 0.01899320363724538, 3.0, 0.010503398181377308,
    0.0010067963627546188, 1.0, 0.010503398181377308, 0.01, @double.not_a_number,
    0.010503398181377308, 0.01899320363724538, 9.0, 0.019496601818622693, 0.0010067963627546188,
    2.0, 0.019496601818622693, 0.01, @double.not_a_number, 0.019496601818622693,
    0.01899320363724538, 7.0, 0.028489805455868076, 0.0010067963627546188, 6.0, 0.028489805455868076,
    0.01, 5.0, 0.028489805455868076, 0.01899320363724538, 1.0,
  ])
  let got = @isolines.isobands(t, [0.5, 3.0, 6.0], "elevation")
  assert_eq(
    digest(got.unwrap(), "elevation"),
    "MultiPolygon|0.5-3|0.0015101945441319247,0.011498867272874231 0.01050339818137731,0.010499622424291411 0.019496601818622693,0.01064237168837467 0.02039592218234723,0.01 0.019496601818622693,0.007751699090688655 0.01050339818137731,0.0055033981813773095 0.006006796362754617,0.0010067963627546188 0.021744902727934043,0.0010067963627546188 0.024892524000969925,0.01 0.019496601818622693,0.013854230130248021 0.01050339818137731,0.01299773454574846 0.0015101945441319247,0.01899320363724538 0.0015101945441319247,0.011498867272874231;0.025492070910119617,0.01899320363724538 0.02848980545586808,0.014496601818622692 0.02848980545586808,0.01899320363724538 0.025492070910119617,0.01899320363724538\nMultiPolygon|3-6|0.0015101945441319247,0.01899320363724538 0.01050339818137731,0.01299773454574846 0.019496601818622693,0.013854230130248021 0.024892524000969925,0.01 0.021744902727934043,0.0010067963627546188 0.02848980545586808,0.0010067963627546188 0.02848980545586808,0.0010067963627546188 0.02848980545586808,0.014496601818622692 0.025492070910119617,0.01899320363724538 0.020995469091496924,0.01899320363724538 0.019496601818622693,0.017708460260496044 0.01050339818137731,0.01599546909149692 0.006006796362754617,0.01899320363724538 0.0015101945441319247,0.01899320363724538",
  )
}

///|
test "isobands one break bands" {
  let t = grid([
    0.0015101945441319247, 0.0010067963627546188, 0.0, 0.0015101945441319247, 0.01,
    5.0, 0.0015101945441319247, 0.01899320363724538, 3.0, 0.010503398181377308, 0.0010067963627546188,
    1.0, 0.010503398181377308, 0.01, 8.0, 0.010503398181377308, 0.01899320363724538,
    9.0, 0.019496601818622693, 0.0010067963627546188, 2.0, 0.019496601818622693,
    0.01, 4.0, 0.019496601818622693, 0.01899320363724538, 7.0, 0.028489805455868076,
    0.0010067963627546188, 6.0, 0.028489805455868076, 0.01, 5.0, 0.028489805455868076,
    0.01899320363724538, 1.0,
  ])
  let got = @isolines.isobands(t, [3.0], "elevation")
  assert_eq(digest(got.unwrap(), "elevation"), "")
}

///|
test "isolines no breaks lines" {
  let t = grid([
    0.0015101945441319247, 0.0010067963627546188, 0.0, 0.0015101945441319247, 0.01,
    5.0, 0.0015101945441319247, 0.01899320363724538, 3.0, 0.010503398181377308, 0.0010067963627546188,
    1.0, 0.010503398181377308, 0.01, 8.0, 0.010503398181377308, 0.01899320363724538,
    9.0, 0.019496601818622693, 0.0010067963627546188, 2.0, 0.019496601818622693,
    0.01, 4.0, 0.019496601818622693, 0.01899320363724538, 7.0, 0.028489805455868076,
    0.0010067963627546188, 6.0, 0.028489805455868076, 0.01, 5.0, 0.028489805455868076,
    0.01899320363724538, 1.0,
  ])
  let got = @isolines.isolines(t, [], "elevation")
  assert_eq(digest(got.unwrap(), "elevation"), "")
}

