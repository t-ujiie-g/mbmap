// The XML module the data worker loads on the first KML or GPX read: both read
// into `@geom.Table` bytes (KML ids beside them), numbers converted by the
// host's `Number` and `String`.

import {
  "t-ujiie-g/mbmap/core",
  "t-ujiie-g/mbmap/geom",
  "t-ujiie-g/mbmap/kml",
  "t-ujiie-g/mbmap/wasmio",
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "+wasm-gc"

pkgtype(kind: "foreign_library")

options(
  link: { "wasm-gc": { "export-memory-name": "memory" } },
)
