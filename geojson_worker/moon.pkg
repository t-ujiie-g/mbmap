// The GeoJSON worker's wasm-gc module: reads GeoJSON sources into tilers and
// cuts their tiles as encoded columnar tiles (`@tiler.encode_tile`) for the
// display worker. js/worker.mjs is its glue.

import {
  "t-ujiie-g/mbmap/core",
  "t-ujiie-g/mbmap/formats",
  "t-ujiie-g/mbmap/geom",
  "t-ujiie-g/mbmap/tiler",
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "+wasm-gc"

pkgtype(kind: "foreign_library")

options(
  link: { "wasm-gc": { "export-memory-name": "memory" } },
)
