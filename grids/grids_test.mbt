///|
/// Whether `a` is `b` within 1e-12 relative: under native `@math` the last bit
/// of a distance can differ from the host's `Math`.
fn close(a : Double, b : Double) -> Bool {
  if b.is_nan() {
    a.is_nan()
  } else {
    (a - b).abs() <= 1.0e-12 * (if b.abs() > 1.0 { b.abs() } else { 1.0 })
  }
}

///|
/// Asserts `got` has rows of `kind` with one ring of `points` points each, at
/// coordinates `want`.
fn check(
  got : @geom.Table?,
  kind : @geom.GeomKind,
  points : Int32,
  want : Array[Double],
) -> Unit raise {
  guard got is Some(t) else { fail("no grid") }
  assert_eq(t.length() * points * 2, want.length())
  assert_eq(t.coords.length(), want.length())
  for f in 0..<t.length() {
    assert_eq(t.kinds[f], kind)
    let (p0, p1) = t.parts(f)
    assert_eq(p1 - p0, 1)
    let (r0, r1) = t.rings(p0)
    assert_eq(r1 - r0, 1)
    let (i0, i1) = t.points(r0)
    assert_eq((i0, i1), (f * points, (f + 1) * points))
  }
  assert_eq(t.columns.length(), 0)
  for i, w in want {
    assert_true(close(t.coords[i], w))
  }
}

///|
test "point_grid matches Turf's pointGrid" {
  for c in grid_cases {
    let (_, x0, y0, x1, y1, side, want) = c
    check(@grids.point_grid(x0, y0, x1, y1, side), Point, 1, want[0])
  }
}

///|
test "square_grid matches Turf's squareGrid" {
  for c in grid_cases {
    let (_, x0, y0, x1, y1, side, want) = c
    check(@grids.square_grid(x0, y0, x1, y1, side), Polygon, 5, want[1])
  }
}

///|
test "hex_grid matches Turf's hexGrid with and without triangles" {
  for c in grid_cases {
    let (_, x0, y0, x1, y1, side, want) = c
    check(@grids.hex_grid(x0, y0, x1, y1, side), Polygon, 7, want[2])
    let triangles = @grids.hex_grid(x0, y0, x1, y1, side, triangles=true)
    check(triangles, Polygon, 4, want[3])
  }
}

///|
test "triangle_grid matches Turf's triangleGrid" {
  for c in grid_cases {
    let (_, x0, y0, x1, y1, side, want) = c
    check(@grids.triangle_grid(x0, y0, x1, y1, side), Polygon, 4, want[4])
  }
}

