///|
test "grids on a flat box are empty, or None where Turf throws on NaN" {
  check(@grids.point_grid(0, 0, 1, 0, 20), Point, 1, [])
  check(@grids.square_grid(0, 0, 1, 0, 20), Polygon, 5, [])
  check(@grids.hex_grid(0, 0, 1, 0, 20), Polygon, 7, [])
  assert_true(@grids.triangle_grid(0, 0, 1, 0, 20) is None)
}

///|
test "a cell wider than the box" {
  check(@grids.point_grid(0, 0, 1, 1, 1.0e6), Point, 1, [0.5, 0.5])
  check(@grids.square_grid(0, 0, 1, 1, 1.0e6), Polygon, 5, [])
  check(@grids.hex_grid(0, 0, 1, 1, 1.0e6), Polygon, 7, [])
  guard @grids.triangle_grid(0, 0, 1, 1, 1.0e6) is Some(t) else {
    fail("no grid")
  }
  assert_eq(t.length(), 2)
}

///|
test "grid row counts match Turf's on a 1° box with 1 km cells" {
  let count = (g : @geom.Table?) => g.map(t => t.length())
  assert_eq(count(@grids.point_grid(0, 0, 1, 1, 1)), Some(12544))
  assert_eq(count(@grids.square_grid(0, 0, 1, 1, 1)), Some(12321))
  assert_eq(count(@grids.hex_grid(0, 0, 1, 1, 1)), Some(4636))
  assert_eq(count(@grids.hex_grid(0, 0, 1, 1, 1, triangles=true)), Some(27816))
  assert_eq(count(@grids.triangle_grid(0, 0, 1, 1, 1)), Some(25088))
}

///|
test "grids refuse NaN, zero and negative cell sides" {
  for side in [nan, 0.0, -1.0, -@double.infinity] {
    assert_true(@grids.point_grid(0, 0, 1, 1, side) is None)
    assert_true(@grids.square_grid(0, 0, 1, 1, side) is None)
    assert_true(@grids.hex_grid(0, 0, 1, 1, side) is None)
    assert_true(@grids.triangle_grid(0, 0, 1, 1, side) is None)
  }
}

///|
test "grids past MAX_GRID_CELLS are None" {
  assert_eq(@grids.MAX_GRID_CELLS, 1_000_000)
  // A 10° box in 10 m cells, and boxes whose loops never end in Turf.
  assert_true(@grids.point_grid(0, 0, 10, 10, 0.01) is None)
  assert_true(@grids.square_grid(0, 0, 10, 10, 0.01) is None)
  assert_true(@grids.hex_grid(0, 0, 10, 10, 0.01) is None)
  let hexes = @grids.hex_grid(0, 0, 1, 1, 0.15)
  assert_eq(hexes.map(t => t.length()), Some(210265))
  assert_true(@grids.hex_grid(0, 0, 1, 1, 0.15, triangles=true) is None)
  assert_true(@grids.triangle_grid(0, 0, 10, 10, 0.01) is None)
  let inf = @double.infinity
  assert_true(@grids.square_grid(inf, inf, -inf, -inf, 5) is None)
  assert_true(@grids.square_grid(-inf, 0, 0, 1, 5) is None)
  let flat = @grids.point_grid(1.0e300, 0, 1.0e300, 1, 5)
  assert_eq(flat.map(t => t.length()), Some(0))
}
