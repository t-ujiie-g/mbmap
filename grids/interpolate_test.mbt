///|
/// A table of Point rows with `z` values.
fn points(rows : Array[(Double, Double, @geom.Prop?)]) -> @geom.Table {
  let b = @geom.TableBuilder::new()
  for r in rows {
    b.point(r.0, r.1)
    b.end_ring()
    b.end_part()
    if r.2 is Some(z) {
      b.prop("z", z)
    }
    b.end_feature(Point)
  }
  b.finish()
}

///|
fn random_table() -> @geom.Table {
  points(random_points.map(p => (p.0, p.1, Some(@geom.Prop::Num(p.2)))))
}

///|
fn values(t : @geom.Table?) -> Array[Double] raise {
  guard t is Some(t) else { fail("no result") }
  guard t.column("z") is Some(c) else { fail("no column") }
  assert_eq(t.columns.length(), 1)
  c.values.map(v => if v is Some(Num(x)) { x } else { -1.0 })
}

///|
test "interpolate matches Turf's on each grid type and weight" {
  let t = random_table()
  for c in interpolate_cases {
    let (grid, weight, want) = c
    let got = values(@grids.interpolate(t, 5, grid, "z", weight))
    assert_eq(got.length(), want.length())
    for i, w in want {
      assert_true(close(got[i], w))
    }
  }
}

///|
test "interpolate keeps the grid of the points' bounding box" {
  let t = random_table()
  let xs = random_points.map(p => p.0)
  let ys = random_points.map(p => p.1)
  let x0 = xs.fold(init=@double.infinity, (a, b) => if b < a { b } else { a })
  let y0 = ys.fold(init=@double.infinity, (a, b) => if b < a { b } else { a })
  let x1 = xs.fold(init=@double.neg_infinity, (a, b) => {
    if b > a {
      b
    } else {
      a
    }
  })
  let y1 = ys.fold(init=@double.neg_infinity, (a, b) => {
    if b > a {
      b
    } else {
      a
    }
  })
  let grids = [
    @grids.point_grid(x0, y0, x1, y1, 5),
    @grids.square_grid(x0, y0, x1, y1, 5),
    @grids.hex_grid(x0, y0, x1, y1, 5),
    @grids.triangle_grid(x0, y0, x1, y1, 5),
  ]
  for g, grid in grids {
    guard grid is Some(grid) else { fail("no grid") }
    guard @grids.interpolate(t, 5, g, "z", 1) is Some(got) else {
      fail("no result")
    }
    assert_eq(got.coords, grid.coords)
    assert_eq(got.kinds, grid.kinds)
    assert_eq(got.point_ends, grid.point_ends)
  }
}

///|
test "interpolate on a data point is NaN, or the mean with weight 0" {
  let side = 222.3901604670658
  let t = points([
    (0, 0, Some(Num(1))),
    (2, 0, Some(Num(2))),
    (0, 2, Some(Num(3))),
    (2, 2, Some(Num(4))),
  ])
  guard @grids.interpolate(t, side, 0, "z", 1) is Some(g) else {
    fail("no result")
  }
  assert_eq(g.coords, [0.0, 0.0, 0.0, 2.0, 2.0, 0.0, 2.0, 2.0])
  assert_true(values(Some(g)).iter().all(v => v.is_nan()))
  let flat = values(@grids.interpolate(t, side, 0, "z", 0))
  assert_eq(flat, [2.75, 2.5, 2.75, 2.0])
}

///|
test "interpolate reads null as 0 and booleans as 0 or 1" {
  let t = points([
    (139.7, 35.6, Some(Null)),
    (139.75, 35.62, Some(Bool(true))),
    (139.72, 35.66, Some(Bool(false))),
    (139.78, 35.7, Some(Num(7))),
  ])
  let want = [
    1.0772951170181564, 0.8920848958581685, 1.504114612112811, 1.1113627227600866,
    1.5994381385661844, 2.6116151378365395,
  ]
  let got = values(@grids.interpolate(t, 3, 1, "z", 1))
  assert_eq(got.length(), want.length())
  for i, w in want {
    assert_true(close(got[i], w))
  }
}

///|
test "interpolate with a NaN point is NaN unless weight 0 makes it count 1" {
  let t = points([
    (139.7, 35.6, Some(Num(1))),
    (139.8, 35.7, Some(Num(2))),
    (nan, 35.65, Some(Num(3))),
  ])
  guard @grids.interpolate(t, 4, 0, "z", 1) is Some(g) else {
    fail("no result")
  }
  assert_eq(g.length(), 9)
  assert_true(close(g.coords[0], 139.70575847690776))
  assert_true(close(g.coords[3], 35.650000000000006))
  assert_true(values(Some(g)).iter().all(v => v.is_nan()))
  let flat = values(@grids.interpolate(t, 4, 0, "z", 0))
  assert_eq(flat, Array::make(9, 2.0))
}

///|
test "interpolate leaves rows other than points out" {
  let b = @geom.TableBuilder::new()
  b.point(0, 0)
  b.point(1, 0)
  b.point(1, 1)
  b.point(0, 0)
  b.end_ring()
  b.end_part()
  b.prop("z", Str("x"))
  b.end_feature(Polygon)
  b.end_feature(NoGeometry)
  for p in random_points {
    b.point(p.0, p.1)
    b.end_ring()
    b.end_part()
    b.prop("z", Num(p.2))
    b.end_feature(Point)
  }
  let t = b.finish()
  let (grid, weight, want) = interpolate_cases[4]
  let got = values(@grids.interpolate(t, 5, grid, "z", weight))
  assert_eq(got.length(), want.length())
  for i, w in want {
    assert_true(close(got[i], w))
  }
}

///|
test "interpolate refuses missing and string values" {
  let t = points([(0, 0, Some(Num(1))), (1, 1, None)])
  assert_true(@grids.interpolate(t, 20, 1, "z", 1) is None)
  assert_true(@grids.interpolate(random_table(), 5, 1, "elevation", 1) is None)
  let s = points([(0, 0, Some(Num(1))), (1, 1, Some(Str("2")))])
  assert_true(@grids.interpolate(s, 20, 1, "z", 1) is None)
}

///|
test "interpolate refuses bad grid types and cell sides" {
  let t = random_table()
  assert_true(@grids.interpolate(t, 5, 4, "z", 1) is None)
  assert_true(@grids.interpolate(t, 5, -1, "z", 1) is None)
  assert_true(@grids.interpolate(t, 0, 1, "z", 1) is None)
  assert_true(@grids.interpolate(t, nan, 1, "z", 1) is None)
  assert_true(@grids.interpolate(t, -5, 0, "z", 1) is None)
}

///|
test "interpolate of no points: empty grids, None where Turf never returns" {
  let t = @geom.Table::new()
  for g in [0, 2, 3] {
    let got = @grids.interpolate(t, 5, g, "z", 1)
    assert_eq(got.map(r => r.length()), Some(0))
  }
  assert_true(@grids.interpolate(t, 5, 1, "z", 1) is None)
}

///|
test "interpolate past MAX_INTERPOLATE_PAIRS is None" {
  assert_eq(@grids.MAX_INTERPOLATE_PAIRS, 100_000_000)
  let rows = Array::makei(1000, i => {
    let v = i.to_double() / 999.0
    (v, v, Some(@geom.Prop::Num(v)))
  })
  assert_true(@grids.interpolate(points(rows), 0.3, 0, "z", 1) is None)
}
