// Expected values from @turf/clusters-dbscan and @turf/clusters-kmeans 7.4.0
// in Node (centroids of empty clusters from skmeans 0.9.7, which Turf calls).

///|
let nan : Double = @double.not_a_number

///|
let inf : Double = @double.infinity

///|
/// A table of Point rows, and a LineString row for each None.
fn table_of(rows : Array[(Double, Double)?]) -> @geom.Table {
  let b = @geom.TableBuilder::new()
  for r in rows {
    match r {
      Some((x, y)) => {
        b.point(x, y)
        b.end_ring()
        b.end_part()
        b.end_feature(Point)
      }
      None => {
        b.point(0.0, 0.0)
        b.point(1.0, 1.0)
        b.end_ring()
        b.end_part()
        b.end_feature(LineString)
      }
    }
  }
  b.finish()
}

///|
/// Park-Miller steps, as the JavaScript that made the expected values.
fn park_miller(seed : Int32) -> () -> Double {
  let mut s = seed.to_double()
  () => {
    s = s * 16807.0 % 2147483647.0
    s / 2147483647.0
  }
}

///|
fn uniform(
  n : Int32,
  seed : Int32,
  x0 : Double,
  y0 : Double,
  w : Double,
  h : Double,
) -> Array[(Double, Double)?] {
  let r = park_miller(seed)
  Array::makei(n, _ => {
    let x = x0 + r() * w
    let y = y0 + r() * h
    Some((x, y))
  })
}

///|
/// `n` points spread by `s` around `c` random centers, taken in turn.
fn clustered(
  n : Int32,
  seed : Int32,
  c : Int32,
  x0 : Double,
  y0 : Double,
  w : Double,
  h : Double,
  s : Double,
) -> Array[(Double, Double)?] {
  let r = park_miller(seed)
  let centers = Array::makei(c, _ => {
    let x = x0 + r() * w
    let y = y0 + r() * h
    (x, y)
  })
  Array::makei(n, i => {
    let (cx, cy) = centers[i % c]
    let x = cx + (r() - 0.5) * s
    let y = cy + (r() - 0.5) * s
    Some((x, y))
  })
}

///|
/// A LineString row before every `every`th point.
fn with_skips(
  pts : Array[(Double, Double)?],
  every : Int32,
) -> Array[(Double, Double)?] {
  let out = []
  for i, p in pts {
    if i % every == every - 1 {
      out.push(None)
    }
    out.push(p)
  }
  out
}

///|
fn random_set(name : String) -> Array[(Double, Double)?] {
  match name {
    "c300" => clustered(300, 7, 6, 139.5, 35.4, 0.5, 0.5, 0.02)
    "u400" => uniform(400, 3, 139.0, 35.0, 1.0, 1.0)
    "u1500" => uniform(1500, 11, 138.0, 34.0, 2.0, 2.0)
    "c200s" => with_skips(clustered(200, 5, 4, -0.2, 51.3, 0.4, 0.3, 0.01), 7)
    "pole" => clustered(120, 9, 3, -180.0, 89.5, 360.0, 0.49, 0.3)
    _ => abort("unknown set")
  }
}

///|
fn ints(a : FixedArray[Int32]) -> Array[Int32] {
  Array::makei(a.length(), i => a[i])
}

///|
fn doubles(a : FixedArray[Double]) -> Array[Double] {
  Array::makei(a.length(), i => a[i])
}

