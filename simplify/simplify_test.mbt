///|
/// Park-Miller steps, as the JS that made the expected values draws them.
priv struct Rng {
  mut s : Double
}

///|
fn Rng::next(self : Rng) -> Double {
  self.s = self.s * 16807.0 % 2147483647.0
  self.s / 2147483647.0
}

///|
fn walk(r : Rng, n : Int32, grid : Bool) -> Array[(Double, Double)] {
  let mut x = 100.0
  let mut y = 50.0
  let out = []
  for _ in 0..<n {
    if grid {
      x += (r.next() * 3.0).floor() - 1.0
      y += (r.next() * 3.0).floor() - 1.0
    } else {
      x += r.next() - 0.5
      y += r.next() - 0.5
    }
    out.push((x, y))
  }
  out
}

///|
fn square(
  r : Rng,
  n : Int32,
  x0 : Double,
  y0 : Double,
  size : Double,
  noise : Double,
) -> Array[(Double, Double)] {
  let out = []
  let nd = n.to_double()
  for i in 0..<n {
    out.push((x0 + size * i.to_double() / nd, y0 + (r.next() - 0.5) * noise))
  }
  for i in 0..<n {
    out.push(
      (x0 + size + (r.next() - 0.5) * noise, y0 + size * i.to_double() / nd),
    )
  }
  for i in 0..<n {
    out.push(
      (
        x0 + size - size * i.to_double() / nd,
        y0 + size + (r.next() - 0.5) * noise,
      ),
    )
  }
  for i in 0..<n {
    out.push(
      (x0 + (r.next() - 0.5) * noise, y0 + size - size * i.to_double() / nd),
    )
  }
  out.push(out[0])
  out
}

///|
/// Rows of parts of rings, each row's geometry as the JS test made it.
fn add_row(
  b : @geom.TableBuilder,
  kind : @geom.GeomKind,
  parts : Array[Array[Array[(Double, Double)]]],
) -> Unit {
  for part in parts {
    for ring in part {
      for p in ring {
        b.point(p.0, p.1)
      }
      b.end_ring()
    }
    b.end_part()
  }
  b.prop("parts", Num(parts.length().to_double()))
  b.end_feature(kind, id=Some(Num(1.0)))
}

///|
fn turf_rows() -> @geom.Table {
  let b = @geom.TableBuilder::new()
  add_row(b, LineString, [[walk({ s: 11.0, }, 500, false)]])
  add_row(b, LineString, [[walk({ s: 12.0, }, 400, true)]])
  let r = Rng::{ s: 13.0, }
  let l1 = walk(r, 100, false)
  let l2 = walk(r, 3, false)
  let l3 = walk(r, 150, true)
  add_row(b, MultiLineString, [[l1], [l2], [l3]])
  let r = Rng::{ s: 14.0, }
  let outer = square(r, 40, 0.0, 0.0, 100.0, 4.0)
  let hole = square(r, 10, 30.0, 30.0, 20.0, 1.0)
  add_row(b, Polygon, [[outer, hole]])
  let r = Rng::{ s: 15.0, }
  let p1 = square(r, 5, 0.0, 0.0, 10.0, 0.5)
  let p2 = square(r, 30, 50.0, 50.0, 5.0, 3.0)
  add_row(b, MultiPolygon, [[p1], [p2]])
  add_row(b, Polygon, [[square({ s: 16.0, }, 3, 0.0, 0.0, 1.0, 0.001)]])
  b.finish()
}

