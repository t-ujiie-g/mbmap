///|
test "contours one row" {
  let got = @density.contours([0.0, 1.0, 2.0, 3.0, 2.0, 1.0], 6, 1, [1.5], true)
  assert_eq(
    digest(got.unwrap()),
    "1.5|5,0.5 4.5,0 3.5,0 2.5,0 2,0.5 2.5,1 3.5,1 4.5,1 5,0.5",
  )
}

///|
test "contours one column" {
  let got = @density.contours([0.0, 1.0, 2.0, 3.0, 2.0, 1.0], 1, 6, [1.5], true)
  assert_eq(
    digest(got.unwrap()),
    "1.5|1,4.5 1,3.5 1,2.5 0.5,2 0,2.5 0,3.5 0,4.5 0.5,5 1,4.5",
  )
}

