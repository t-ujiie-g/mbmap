// Worker-side tile processing. The pure part (processor.mbt, packed.mbt) runs and
// is tested on every backend; linear_memory.mbt is the wasm-gc export surface
// used by worker/js/worker.mjs.

import {
  "t-ujiie-g/mbmap/core",
  "t-ujiie-g/mbmap/mvt",
  "t-ujiie-g/mbmap/style",
  "t-ujiie-g/mbmap/tess",
  "moonbitlang/core/cmp",
  "moonbitlang/core/encoding/utf8",
}

pkgtype(kind: "foreign_library")

options(
  targets: { "linear_memory.mbt": [ "wasm", "wasm-gc" ] },
  link: {
    "wasm": { "export-memory-name": "memory" },
    "wasm-gc": { "export-memory-name": "memory" },
  },
)

import {
  "t-ujiie-g/mbmap/pbf",
  "moonbitlang/core/encoding/utf8",
} for "test"
