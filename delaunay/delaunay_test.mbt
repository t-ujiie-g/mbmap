  assert_eq(rows(@delaunay.triangles(t)), [])
  assert_eq(rows(@delaunay.voronoi(t, -1.0, -1.0, 6.0, 6.0)), [
    Some([6.0, -1.0, 6.0, 6.0, -1.0, 6.0, -1.0, -1.0, 6.0, -1.0]),
    None,
    None,
    None,
    None,
