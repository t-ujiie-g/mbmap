// The GeoTIFF module the data worker loads on the first raster read: a TIFF's
// image directories, and windows of its blocks decoded into bands.

import {
  "t-ujiie-g/mbmap/core",
  "t-ujiie-g/mbmap/tiff",
  "t-ujiie-g/mbmap/wasmio",
}

supported_targets = "+wasm-gc"

pkgtype(kind: "foreign_library")

options(
  link: { "wasm-gc": { "export-memory-name": "memory" } },
)
