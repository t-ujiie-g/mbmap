        5.308831562334683e-15, 3383305542250365400.0, 1007688986801094800.0,
      ),
      0.0012065220509031736,
    ),
    (
      (
        -2.3757576006325344e-9, -7.332494869337202e-9, 0.03154871118191024, 0.09737137802166038,
        99997512469544500000.0, 308630534279345400000.0,
      ),
      -90711.70141877902,
    ),
    ((0.5000000000000001, 0.5000000000000001, 12.0, 12.0, 24.0, 24.0), -0.0),
    ((0.5000000000000006, 0.5000000000000006, 12.0, 12.0, 24.0, 24.0), -0.0),
  ]
  for c in cases {
    let ((ax, ay, bx, by, cx, cy), want) = c
    let got = @robust.orient2d(ax, ay, bx, by, cx, cy)
    assert_eq(got.reinterpret_as_int64(), want.reinterpret_as_int64())
  }
}

///|
test "orient2d propagates NaN and infinities as robust-predicates does" {
  assert_true(@robust.orient2d(@double.not_a_number, 0, 1, 1, 2, 2).is_nan())
  assert_eq(@robust.orient2d(@double.infinity, 0, 1, 1, 2, 2), @double.infinity)
}

///|
test "orient2d sign tells clockwise from counter-clockwise" {
  assert_true(@robust.orient2d(0, 0, 1, 0, 0, 1) < 0)
  assert_true(@robust.orient2d(0, 0, 0, 1, 1, 0) > 0)
}
