// The module the analysis worker loads on its first viewshed: GDAL's viewshed
// over a grid's elevations, computing with the host's Math.

import {
  "t-ujiie-g/mbmap/viewshed",
  "t-ujiie-g/mbmap/wasmio",
}

supported_targets = "+wasm-gc"

pkgtype(kind: "foreign_library")

options(
  link: { "wasm-gc": { "export-memory-name": "memory" } },
)
