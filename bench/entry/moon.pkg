// Export surface for the mvt and tess benches and golden tests; names come from `#export_name`.

import {
  "t-ujiie-g/mbmap/clipper",
  "t-ujiie-g/mbmap/cluster_props",
  "t-ujiie-g/mbmap/core",
  "t-ujiie-g/mbmap/draco",
  "t-ujiie-g/mbmap/lepcc",
  "t-ujiie-g/mbmap/formats",
  "t-ujiie-g/mbmap/geom",
  "t-ujiie-g/mbmap/globe",
  "t-ujiie-g/mbmap/meshopt",
  "t-ujiie-g/mbmap/mvt",
  "t-ujiie-g/mbmap/proj",
  "t-ujiie-g/mbmap/route",
  "t-ujiie-g/mbmap/style",
  "t-ujiie-g/mbmap/tess",
  "t-ujiie-g/mbmap/tiler",
  "moonbitlang/core/double",
}

supported_targets = "+js+wasm+wasm-gc"

pkgtype(kind: "foreign_library")

options(
  targets: {
    "golden.mbt": [ "js" ],
    "js_input.mbt": [ "js" ],
    "linear_memory.mbt": [ "wasm", "wasm-gc" ],
    "host_math.mbt": [ "wasm", "wasm-gc" ],
    "meshopt_mem.mbt": [ "wasm", "wasm-gc" ],
  },
  link: {
    "wasm": { "export-memory-name": "memory" },
    "wasm-gc": { "export-memory-name": "memory" },
    "js": { "format": "esm" },
  },
)
