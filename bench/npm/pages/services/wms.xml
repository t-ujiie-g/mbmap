  </Service>
  <Capability>
    <Request>
      <GetMap>
        <Format>image/png</Format>
        <DCPType><HTTP><Get><OnlineResource xlink:href="../../../fixtures/gsi-std/14/14552/6451.png?map=test"/></Get></HTTP></DCPType>
