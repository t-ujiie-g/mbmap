{
  "name": "mbmap-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "build:moon": "cd .. && for t in wasm wasm-gc js; do moon build bench/backend/entry --release --target $t || exit 1; done && for t in wasm-gc js; do moon build bench/entry --release --target $t || exit 1; done && moon build worker analysis_worker geometry_worker proj_worker --release --target wasm-gc && moon build bundle/main --release --target js && npm --prefix bench run opt",
    "opt": "node backend/opt.mjs",
    "test": "node --test lib/*.test.mjs",
    "fixtures": "node maplibre/fetch-tiles.mjs",
    "backend:node": "npm run build:moon && node backend/node.mjs",
    "backend:browser": "npm run build:moon && node backend/browser.mjs",
    "maplibre:parse": "node maplibre/parse-tile.mjs",
    "maplibre": "node maplibre/run.mjs --runs=5 && node maplibre/run.mjs --runs=5 --uncapped && node maplibre/run.mjs --runs=5 --throttle=4 && node maplibre/run.mjs --runs=5 --throttle=4 --uncapped",
    "mvt:golden": "npm run build:moon && node mvt/golden.mjs",
    "mvt:node": "npm run build:moon && node mvt/node.mjs",
    "mvt:browser": "npm run build:moon && node mvt/browser.mjs",
    "tess:golden": "npm run build:moon && node tess/golden.mjs",
    "tess:node": "npm run build:moon && node lib/run-bundled.mjs bench/tess/node.mjs",
    "tess:browser": "npm run build:moon && node tess/browser.mjs",
    "render": "npm run build:moon && node render/run.mjs && node render/run.mjs --uncapped",
    "example": "npm run build:moon && node lib/serve.mjs 8080",
    "worker:browser": "npm run build:moon && node worker/browser.mjs",
    "npm:pack": "node npm/pack-test.mjs",
    "examples": "node npm/prepare.mjs && npm run example",
    "split": "node split/run.mjs --runs=15",
    "geojson:golden": "npm run build:moon && node --max-old-space-size=8192 geojson/golden.mjs",
    "geojson:node": "npm run build:moon && node --max-old-space-size=8192 geojson/node.mjs",
    "geojson:browser": "npm run build:moon && node geojson/browser.mjs",
    "analysis:golden": "npm run build:moon && node --max-old-space-size=8192 analysis/golden.mjs",
    "analysis:node": "npm run build:moon && node --max-old-space-size=8192 analysis/node.mjs",
    "analysis:browser": "npm run build:moon && node analysis/browser.mjs",
    "terrain:golden": "npm run build:moon && node terrain/golden.mjs",
    "clipper:golden": "npm run build:moon && node clipper/golden.mjs && node clipper/offset-golden.mjs",
    "proj:golden": "npm run build:moon && node proj/golden.mjs",
    "buffer:check": "npm run build:moon && node clipper/buffer-check.mjs",
    "geometry:node": "npm run build:moon && node clipper/node.mjs"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@maplibre/geojson-vt": "6.3.0",
    "@turf/area": "7.4.0",
    "@turf/bbox": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/centroid": "7.4.0",
    "@turf/collect": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/length": "7.4.0",
    "@turf/points-within-polygon": "7.4.0",
    "binaryen": "132.0.0",
    "earcut": "3.2.4",
    "esbuild": "0.28.2",
    "flatbush": "4.6.2",
    "maplibre-gl": "6.16.0",
    "pbf": "5.1.2",
    "playwright": "1.64.1"
  },
  "dependencies": {
    "@turf/buffer": "7.4.0",
    "@turf/difference": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@turf/union": "7.4.0",
    "clipper2-wasm": "0.4.0",
    "geographiclib-geodesic": "2.2.0",
    "proj4": "2.22.0"
  }
}
