{
  "name": "mbmap-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "build:moon": "cd .. && for t in wasm wasm-gc js; do moon build bench/backend/entry --release --target $t || exit 1; done && for t in wasm-gc js; do moon build bench/entry --release --target $t || exit 1; done && moon build worker bench/worker/compile_entry analysis_worker geometry_worker relate_worker shapes_worker surface_worker proj_worker geodesic_worker data_worker geotiff_worker services_worker --release --target wasm-gc && moon build bundle/main bench/expr --release --target js && npm --prefix bench run opt",
    "opt": "node backend/opt.mjs",
    "test": "node --test lib/*.test.mjs",
    "fixtures": "node maplibre/fetch-tiles.mjs",
    "backend:node": "npm run build:moon && node backend/node.mjs",
    "backend:browser": "npm run build:moon && node backend/browser.mjs",
    "maplibre:parse": "node maplibre/parse-tile.mjs",
    "maplibre": "node maplibre/run.mjs --runs=5 && node maplibre/run.mjs --runs=5 --uncapped && node maplibre/run.mjs --runs=5 --throttle=4 && node maplibre/run.mjs --runs=5 --throttle=4 --uncapped",
    "mvt:golden": "npm run build:moon && node mvt/golden.mjs",
    "mvt:node": "npm run build:moon && node mvt/node.mjs",
    "mvt:browser": "npm run build:moon && node mvt/browser.mjs",
    "tess:golden": "npm run build:moon && node tess/golden.mjs",
    "tess:node": "npm run build:moon && node lib/run-bundled.mjs bench/tess/node.mjs",
    "tess:browser": "npm run build:moon && node tess/browser.mjs",
    "render": "npm run build:moon && node render/run.mjs && node render/run.mjs --uncapped",
    "example": "npm run build:moon && node lib/serve.mjs 8080",
    "worker:browser": "npm run build:moon && node worker/browser.mjs",
    "npm:pack": "node npm/pack-test.mjs",
    "examples": "node npm/prepare.mjs && npm run example",
    "split": "node split/run.mjs --runs=15",
    "geojson:golden": "npm run build:moon && node --max-old-space-size=8192 geojson/golden.mjs",
    "cluster:golden": "npm run build:moon && node --max-old-space-size=8192 geojson/cluster-golden.mjs",
    "geojson:node": "npm run build:moon && node --max-old-space-size=8192 geojson/node.mjs",
    "geojson:browser": "npm run build:moon && node geojson/browser.mjs",
    "analysis:golden": "npm run build:moon && node --max-old-space-size=8192 analysis/golden.mjs",
    "analysis:node": "npm run build:moon && node --max-old-space-size=8192 analysis/node.mjs",
    "analysis:browser": "npm run build:moon && node analysis/browser.mjs",
    "terrain:golden": "npm run build:moon && node terrain/golden.mjs",
    "clipper:golden": "npm run build:moon && node clipper/golden.mjs && node clipper/offset-golden.mjs",
    "pmtiles:golden": "npm --prefix ../npm run build && node pmtiles/golden.mjs",
    "raster:golden": "npm --prefix ../npm run build && node raster/golden.mjs",
    "query:golden": "npm --prefix ../npm run build && node query/golden.mjs",
    "track:golden": "npm --prefix ../npm run build && node track/golden.mjs",
    "export:golden": "npm --prefix ../npm run build && node export/golden.mjs",
    "ui:golden": "npm --prefix ../npm run build && node ui/golden.mjs",
    "camera:golden": "npm run build:moon && node lib/run-bundled.mjs bench/camera/golden.mjs",
    "proj:golden": "npm run build:moon && node proj/golden.mjs",
    "proj:node": "npm run build:moon && node proj/node.mjs",
    "buffer:check": "npm run build:moon && node clipper/buffer-check.mjs",
    "geodesic:golden": "npm run build:moon && node geodesic/golden.mjs",
    "relate:golden": "npm run build:moon && node relate/golden.mjs",
    "classify:golden": "node --experimental-strip-types classify/golden.mjs",
    "shapes:golden": "npm run build:moon && node shapes/golden.mjs",
    "surface:golden": "npm run build:moon && node surface/golden.mjs",
    "data:golden": "cd .. && moon build data_worker proj_worker --release --target wasm-gc && cd bench && node data/golden.mjs",
    "fgb:golden": "cd .. && moon build data_worker proj_worker --release --target wasm-gc && cd bench && node data/fgb-golden.mjs",
    "geotiff:golden": "cd .. && moon build data_worker geotiff_worker --release --target wasm-gc && cd bench && node --max-old-space-size=4096 data/geotiff-golden.mjs",
    "geotiff:tiles": "npm --prefix ../npm run build && node geotiff/tiles-golden.mjs",
    "write:golden": "cd .. && moon build data_worker xml_worker --release --target wasm-gc && cd bench && node data/write-golden.mjs",
    "services:style": "node services/style.mjs",
    "services:golden": "node lib/run-bundled.mjs bench/services/golden.mjs",
    "reproject:golden": "npm --prefix ../npm run build && node services/reproject-golden.mjs",
    "esri:golden": "cd .. && moon build services_worker --release --target wasm-gc && cd bench && node services/esri-golden.mjs",
    "xml:golden": "cd .. && moon build xml_worker --release --target wasm-gc && cd bench && node data/xml-golden.mjs",
    "draw:setdata": "npm --prefix ../npm run build && node draw/run.mjs",
    "style:golden": "npm --prefix ../npm run build && node style/golden.mjs",
    "style:public": "npm --prefix ../npm run build && node style/public.mjs",
    "style:compat": "npm --prefix ../npm run build && node style/compat.mjs",
    "labels:golden": "npm --prefix ../npm run build && node labels/golden.mjs",
    "expression:golden": "cd .. && moon build bench/expr --release --target js && cd bench && node style/expressions.mjs",
    "color:golden": "cd .. && moon build bench/expr --release --target js && cd bench && node lib/run-bundled.mjs bench/style/colors.mjs",
    "draw:golden": "npm --prefix ../npm run build && node draw/golden.mjs",
    "draw:many": "npm --prefix ../npm run build && node draw/many-run.mjs --shapes=2000",
    "geometry:node": "npm run build:moon && node clipper/node.mjs"
  },
  "devDependencies": {
    "@camptocamp/ogc-client": "2.0.2",
    "@mapbox/vector-tile": "3.0.0",
    "@maplibre/geojson-vt": "6.3.0",
    "@placemarkio/tokml": "0.4.0",
    "@protomaps/basemaps": "5.7.2",
    "@terraformer/arcgis": "2.2.2",
    "@tmcw/togeojson": "7.1.3",
    "@turf/area": "7.4.0",
    "@turf/bbox": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/centroid": "7.4.0",
    "@turf/clusters-dbscan": "7.4.0",
    "@turf/clusters-kmeans": "7.4.0",
    "@turf/collect": "7.4.0",
    "@turf/convex": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/hex-grid": "7.4.0",
    "@turf/interpolate": "7.4.0",
    "@turf/isobands": "7.4.0",
    "@turf/isolines": "7.4.0",
    "@turf/length": "7.4.0",
    "@turf/line-slice": "7.4.0",
    "@turf/nearest-point-on-line": "7.4.0",
    "@turf/point-grid": "7.4.0",
    "@turf/points-within-polygon": "7.4.0",
    "@turf/simplify": "7.4.0",
    "@turf/square-grid": "7.4.0",
    "@turf/triangle-grid": "7.4.0",
    "@xmldom/xmldom": "0.9.12",
    "arcgis-pbf-parser": "0.0.4",
    "betterknown": "1.2.0",
    "binaryen": "132.0.0",
    "concaveman": "2.0.0",
    "d3-contour": "4.0.3",
    "d3-delaunay": "6.0.6",
    "delaunator": "5.1.0",
    "earcut": "3.2.4",
    "esbuild": "0.28.2",
    "flatbuffers": "25.9.23",
    "flatbush": "4.6.2",
    "flatgeobuf": "4.6.1",
    "geostats": "2.1.0",
    "geotiff": "3.0.5",
    "jsts": "2.12.1",
    "maplibre-gl": "6.16.0",
    "ol": "10.11.0",
    "papaparse": "5.7.0",
    "pbf": "5.1.2",
    "playwright": "1.64.1",
    "pmtiles": "4.5.0",
    "robust-predicates": "3.0.3",
    "shpjs": "6.2.0",
    "simple-statistics": "8.0.0",
    "terra-draw": "1.37.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "wkx": "0.5.0"
  },
  "dependencies": {
    "@turf/buffer": "7.4.0",
    "@turf/difference": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@turf/union": "7.4.0",
    "clipper2-wasm": "0.4.0",
    "geographiclib-geodesic": "2.2.0",
    "proj4": "2.22.0"
  }
}
