///|
/// Points as concaveman's tests in JS made them: Park-Miller steps scaled
/// by `scale`, rounded to integers when `round`.
fn random_points(
  n : Int32,
  seed : Int32,
  scale : Double,
  round : Bool,
) -> @geom.Table {
  let b = @geom.TableBuilder::new()
  let mut s = seed.to_double()
  let rnd = () => {
    s = s * 16807.0 % 2147483647.0
    s / 2147483647.0
  }
  for _ in 0..<n {
    let mut x = rnd() * scale
    let mut y = rnd() * scale
    if round {
      x = (x + 0.5).floor()
      y = (y + 0.5).floor()
    }
    b.point(x, y)
  }
  b.end_ring()
  b.end_part()
  b.end_feature(MultiPoint)
  b.finish()
}

